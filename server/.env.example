# Copy to server/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Postgres. Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/denimque?schema=public"

# Must be at least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to send cookies. Doubles as
# the allowlist that rejects cross-origin state-changing requests. REQUIRED in
# production — the localhost default is not applied there.
CORS_ORIGIN=http://localhost:5173
# COOKIE_DOMAIN=.denimque.com
# lax | strict | none. Keep `lax` when the storefront and API share a
# registrable domain (denimque.com + api.denimque.com). `none` is only for a
# genuinely cross-site deployment and additionally requires HTTPS and
# COOKIE_DOMAIN.
# COOKIE_SAMESITE=lax

# IANA zone for every server-side day boundary: dashboard "today", due-today /
# due-tomorrow windows, and overdue calculation. Independent of the server's
# own clock zone.
BUSINESS_TIMEZONE=Asia/Kolkata

# Admin bootstrap — read by `npm run seed` only, never by the running API.
# Omit ADMIN_PASSWORD and the seed generates one and prints it once.
# An existing admin's password is only changed if ADMIN_PASSWORD is set.
# ADMIN_EMAIL=admin@denimque.com
# ADMIN_PASSWORD=

# With NODE_ENV=production the seed only bootstraps the admin account. The
# sample catalogue and the demo customer are skipped, because re-running the
# seed would overwrite live prices, stock and images. Set this only when
# deliberately populating a brand-new production database.
# SEED_CATALOGUE=true

# ── Payments ────────────────────────────────────────────────────────────────
# Which gateways may be offered. Options: auto | manual | razorpay | phonepe |
# stripe, or a comma-separated list.
#
#   auto     — offer every gateway whose credentials are present; fall back to
#              `manual` when none are. This is the default.
#   manual   — bank transfer / pay on delivery only. Orders are reserved as
#              PENDING and reconciled by an admin.
#   razorpay — offer only Razorpay. If its credentials are missing the provider
#              is reported unavailable; checkout refuses to open a charge and no
#              order is ever marked paid.
#
# A gateway only ever appears in checkout when it is both listed here and fully
# configured below.
PAYMENT_PROVIDER=manual

# test | live. Defaults to `live` under NODE_ENV=production and `test`
# otherwise. A gateway whose key shape disagrees with this (an sk_live_ key in
# test mode, say) is treated as misconfigured rather than used.
# PAYMENT_MODE=test

# Origin gateways redirect the customer back to, and the origin the webhook
# URLs handed to gateways are built from. Defaults to the first CORS_ORIGIN.
# Set this in production if the API is reachable on a different host.
# PAYMENT_RETURN_ORIGIN=https://denimque.com

# ── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys (key id + secret), and
# Settings → Webhooks for the webhook secret. All three are required: without
# the webhook secret a callback cannot be authenticated, so the provider stays
# unavailable rather than trusting an unsigned one.
# Webhook URL: https://<api-host>/api/payments/webhooks/razorpay
# Events:      payment.captured, payment.failed, payment.authorized, refund.processed
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── PhonePe ─────────────────────────────────────────────────────────────────
# PhonePe onboards each merchant onto one API generation. Set the one your
# merchant pack documents — do not guess.
#   v2 = PG Standard Checkout (OAuth client credentials)
#   v1 = legacy salt-key PG (X-VERIFY checksum)
# PHONEPE_API_VERSION=v2
#
# Base URLs. Optional in test mode (sandbox defaults are used); REQUIRED in live
# mode, because PhonePe issues host names per merchant and defaulting would risk
# pointing production at the sandbox.
# PHONEPE_BASE_URL=
# PHONEPE_AUTH_BASE_URL=
#
# v2 credentials:
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_CLIENT_VERSION=
# Username/password pair configured on the PhonePe dashboard for callback
# authentication; PhonePe sends SHA-256("username:password") as the callback's
# Authorization header.
# PHONEPE_CALLBACK_USERNAME=
# PHONEPE_CALLBACK_PASSWORD=
#
# v1 credentials:
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=
# PHONEPE_SALT_INDEX=
#
# Webhook/callback URL: https://<api-host>/api/payments/webhooks/phonepe

# ── Stripe ──────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys, and Developers → Webhooks for whsec_.
# The publishable key is safe in a browser; the other two never leave the server.
# Webhook URL: https://<api-host>/api/payments/webhooks/stripe
# Events:      checkout.session.completed, checkout.session.expired,
#              checkout.session.async_payment_succeeded,
#              checkout.session.async_payment_failed,
#              payment_intent.payment_failed, charge.refunded
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# Email: log | resend | smtp  (`log` prints to stdout, sends nothing)
EMAIL_PROVIDER=log
# RESEND_API_KEY=
EMAIL_FROM="DENIMQUE <hello@denimque.com>"
CONTACT_INBOX=hello@denimque.com
