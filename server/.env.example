# Copy to server/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Postgres. Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/denimque?schema=public"

# Must be at least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to send cookies.
CORS_ORIGIN=http://localhost:5173
# COOKIE_DOMAIN=.denimque.com

# Payments: manual | razorpay | stripe
# `manual` reserves orders as PENDING for off-platform settlement.
PAYMENT_PROVIDER=manual
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Email: log | resend | smtp  (`log` prints to stdout, sends nothing)
EMAIL_PROVIDER=log
# RESEND_API_KEY=
EMAIL_FROM="DENIMQUE <hello@denimque.com>"
CONTACT_INBOX=hello@denimque.com
