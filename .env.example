# Frontend environment. Copy to .env.local for local overrides.

# Leave unset in development — Vite proxies /api to the Express server
# (see vite.config.ts). Set this in production to the deployed API origin.
# VITE_API_URL=https://api.denimque.com

# Dev-only: change where /api is proxied if the API isn't on :4000.
# VITE_PROXY_TARGET=http://localhost:4000
